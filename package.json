{
  "name": "estonian-law-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "oxlint src tests evals web/src",
    "lint:fix": "oxlint --fix src tests evals web/src",
    "typecheck": "tsc",
    "migrate": "node src/scripts/migrate.ts",
    "migrate:rollback": "node src/scripts/migrate.ts rollback",
    "import:act": "node src/scripts/import-act.ts",
    "embed": "node src/scripts/embed-sections.ts",
    "eval": "node evals/run-eval.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@huggingface/transformers": "^3.0.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "fastify": "^5.0.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxlint": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
